{
  "name": "@eq/desktop",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "dist": "npm --prefix ../ui run build && node scripts/build.mjs && node scripts/fetch-binaries.mjs && electron-builder --win portable --x64 --publish never",
